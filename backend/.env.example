# Managed MySQL 8 (Aiven). Copy to backend/.env - it is gitignored - and fill in.
# Use the plain URL: Aiven's "?ssl-mode=REQUIRED" is a MySQL-CLI option PyMySQL rejects;
# TLS is configured with APP_DB_SSL_CA instead.
APP_DATABASE_URL=mysql+pymysql://avnadmin:<password>@<service>.aivencloud.com:<port>/defaultdb
# CA certificate from the Aiven console (service Overview -> CA certificate).
# On the host, its path; Docker Compose mounts backend/ca.pem and overrides this.
APP_DB_SSL_CA=D:/Projects/salary-management/backend/ca.pem

APP_SQL_ECHO=false
APP_CORS_ORIGINS=["http://localhost:5173"]

# Integration tests only. They DROP and recreate every table, so this must be a
# separate database whose name ends in _test (create it in the Aiven console);
# the test suite refuses to run against anything else.
APP_TEST_DATABASE_URL=mysql+pymysql://avnadmin:<password>@<service>.aivencloud.com:<port>/salary_test
